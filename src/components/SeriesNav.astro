---
// 目录侧栏：技术理论的系列文章、项目的各页共用，列出同一系列（或同一项目）的全部页面。
//
// 宽屏：贴在窗口左边缘，平时只露出一个「目录」把手；鼠标移到把手上展开，移开收起，
//       盖在正文上方，随页面滚动保持不动。点击把手可固定展开，再点一次、按 Esc 或点别处收起。
// 手机：放在页面顶部，作为普通的折叠目录，点「目录」展开。
// pinned（项目页用）：窗口够宽、侧栏不会盖住正文时（≥ 75rem）常驻展开，不需要把手。
import type { MarkdownHeading } from 'astro';
import WriteLink from './WriteLink.astro';
import { entryUrl, type Entry } from '../utils';

interface Props {
  /** 目录顶部的名称：系列名或项目名 */
  name: string;
  /** 按阅读顺序排好的页面 */
  entries: Entry[];
  /** 目录底部「续写」链接（只对登录过后台的浏览器显示） */
  continueHref: string;
  continueLabel: string;
  /** 宽屏常驻展开 */
  pinned?: boolean;
  /** 当前页的小标题，列在目录里当前页下面（只取二、三级标题） */
  headings?: MarkdownHeading[];
}

const { name, entries, continueHref, continueLabel, pinned = false, headings = [] } = Astro.props;
const outline = headings.filter((h) => h.depth <= 3 && h.text.trim());
const path = Astro.url.pathname;
---

<aside class:list={['toc', { pinned }]} data-toc>
  <button class="handle" type="button" aria-expanded="false" aria-controls="toc-panel">目录</button>
  <nav id="toc-panel" class="panel" aria-label={`「${name}」目录`}>
    <p class="name">{name}</p>
    <ol>
      {
        entries.map((e) => (
          <li>
            <a href={entryUrl(e)} aria-current={path === entryUrl(e) ? 'page' : undefined}>
              {e.data.title}
            </a>
            {path === entryUrl(e) && outline.length > 0 && (
              <ul class="outline">
                {outline.map((h) => (
                  <li class={`h${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
    <p class="continue"><WriteLink href={continueHref} label={continueLabel} /></p>
  </nav>
</aside>

<script>
  // 点击把手切换"固定展开"；Esc 或点击侧栏以外的地方收起
  for (const toc of document.querySelectorAll<HTMLElement>('[data-toc]')) {
    const handle = toc.querySelector<HTMLButtonElement>('.handle')!;
    const setOpen = (open: boolean) => {
      toc.toggleAttribute('data-open', open);
      handle.setAttribute('aria-expanded', String(open));
    };
    handle.addEventListener('click', () => setOpen(!toc.hasAttribute('data-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toc.hasAttribute('data-open')) {
        setOpen(false);
        handle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      const wide = matchMedia('(min-width: 48rem)').matches;
      if (wide && !toc.contains(e.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .panel {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .name {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .panel ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  .panel li::marker {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .panel a {
    display: block;
    padding: 0.3rem 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .panel a:hover {
    color: var(--color-accent);
  }

  .panel a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* 当前页的小标题：比页面标题小一号、颜色浅，三级标题再缩进一层 */
  .outline {
    margin: 0 0 0.5rem;
    padding-left: 0.75rem;
    list-style: none;
    border-left: 1px solid var(--color-rule);
  }

  .panel .outline a {
    padding: 0.2rem 0;
    color: var(--color-muted);
  }

  .panel .outline a:hover {
    color: var(--color-accent);
  }

  .outline .h3 {
    padding-left: 0.9rem;
  }

  .continue {
    margin: 1rem 0 0;
  }

  .continue:has([hidden]) {
    display: none;
  }

  .handle {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    cursor: pointer;
  }

  .handle:hover {
    color: var(--color-accent);
  }

  /* 宽屏：贴边的悬浮侧栏 */
  @media (min-width: 48rem) {
    .toc {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 20;
      width: 19rem;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }

    /* 鼠标悬停、键盘聚焦、点击固定时展开 */
    .toc:hover,
    .toc:has(:focus-visible),
    .toc[data-open] {
      transform: none;
    }

    .panel {
      height: 100%;
      overflow-y: auto;
      padding: 2rem 1.25rem 3rem 1.5rem;
      background: var(--color-bg);
      border-right: 1px solid var(--color-rule);
    }

    /* 把手：从侧栏右边缘伸出，竖排文字 */
    .handle {
      position: absolute;
      top: 8rem;
      left: 100%;
      /* 宽度只容一个字，"目录"两字自然竖排 */
      width: 1.9rem;
      padding: 0.75rem 0.4rem;
      line-height: 1.3;
      letter-spacing: 0.2em;
      border-left: none;
      border-radius: 0 var(--radius) var(--radius) 0;
    }
  }

  /* 常驻：16rem 宽的侧栏 + 居中的正文容器（40rem 正文 + 两侧 1.5rem 间距）不重叠，
     需要窗口 ≥ 16 × 2 + 43 = 75rem */
  @media (min-width: 75rem) {
    .toc.pinned {
      width: 16rem;
      transform: none;
      transition: none;
    }

    .pinned .handle {
      display: none;
    }
  }

  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .toc {
      transition: none;
    }
  }

  /* 手机：页面顶部的折叠目录 */
  @media (max-width: 47.99rem) {
    .toc {
      margin-bottom: 2rem;
    }

    .handle {
      width: 100%;
      padding: 0.5rem 0.75rem;
      text-align: left;
      border-radius: var(--radius);
    }

    .handle::after {
      content: ' ▾';
    }

    .toc[data-open] .handle::after {
      content: ' ▴';
    }

    .toc:not([data-open]) .panel {
      display: none;
    }

    .panel {
      padding: 1rem 0.75rem 0;
    }
  }
</style>
