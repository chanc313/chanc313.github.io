---
// 目录侧栏：目录里的页面（文章、有正文的目录）共用，列出所在一级目录（话题、项目）的目录树。
// 当前页所在的各级目录展开，其他目录收起，见 FolderTree.astro。
//
// 宽屏：贴在窗口左边缘，平时只露出一个「目录」把手；鼠标移到把手上展开，移开收起，
//       盖在正文上方，随页面滚动保持不动。点击把手可固定展开，再点一次、按 Esc 或点别处收起。
// 手机：放在页面顶部，作为普通的折叠目录，点「目录」展开。
// pinned（项目页用，配合 EntryLayout 的 wide）：窗口 ≥ 68rem 时作为正文左侧的一列常驻，
//       随页面滚动停在顶部，不需要把手；更窄时与普通侧栏相同。
import type { MarkdownHeading } from 'astro';
import FolderTree from './FolderTree.astro';
import Outline from './Outline.astro';
import WriteLink from './WriteLink.astro';
import { entryUrl, isFolder, type TreeNode } from '../utils';

interface Props {
  /** 一级目录：侧栏顶部显示它的名称，下面是它的目录树 */
  root: TreeNode;
  /** 当前页 */
  current: TreeNode;
  /** 当前页的小标题，列在目录里当前页下面 */
  headings?: MarkdownHeading[];
  /** 宽屏常驻展开 */
  pinned?: boolean;
}

const { root, current, headings = [], pinned = false } = Astro.props;
const name = root.entry.data.title;
// 底部「新建」链接（只对登录过后台的浏览器显示）：在当前页所在的目录里新建，当前页是目录时就在它里面
const here = isFolder(current.entry) ? current : current.parent!;
const writeHref = `/write/?${new URLSearchParams({ column: here.entry.collection, parent: here.entry.id })}`;
---

<aside class:list={['toc', { pinned }]} data-toc>
  <button class="handle" type="button" aria-expanded="false" aria-controls="toc-panel">目录</button>
  <nav id="toc-panel" class="panel" aria-label={`「${name}」目录`}>
    <p class="name">
      <a href={entryUrl(root.entry)} aria-current={root === current ? 'page' : undefined}>{name}</a>
    </p>
    {root === current && <Outline headings={headings} />}
    <FolderTree nodes={root.children} current={current} headings={headings} />
    <p class="continue"><WriteLink href={writeHref} label={`＋ 在「${here.entry.data.title}」里新建`} /></p>
  </nav>
</aside>

<script>
  // 点击把手切换"固定展开"；Esc 或点击侧栏以外的地方收起
  for (const toc of document.querySelectorAll<HTMLElement>('[data-toc]')) {
    const handle = toc.querySelector<HTMLButtonElement>('.handle')!;
    const setOpen = (open: boolean) => {
      toc.toggleAttribute('data-open', open);
      handle.setAttribute('aria-expanded', String(open));
    };
    handle.addEventListener('click', () => setOpen(!toc.hasAttribute('data-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toc.hasAttribute('data-open')) {
        setOpen(false);
        handle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      const wide = matchMedia('(min-width: 48rem)').matches;
      if (wide && !toc.contains(e.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .panel {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .name {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .name a:hover,
  .name a[aria-current='page'] {
    color: var(--color-accent);
  }

  .continue {
    margin: 1rem 0 0;
  }

  .continue:has([hidden]) {
    display: none;
  }

  .handle {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    cursor: pointer;
  }

  .handle:hover {
    color: var(--color-accent);
  }

  /* 宽屏：贴边的悬浮侧栏 */
  @media (min-width: 48rem) {
    .toc {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 20;
      width: 19rem;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }

    /* 鼠标悬停、键盘聚焦、点击固定时展开 */
    .toc:hover,
    .toc:has(:focus-visible),
    .toc[data-open] {
      transform: none;
    }

    .panel {
      height: 100%;
      overflow-y: auto;
      padding: 2rem 1.25rem 3rem 1.5rem;
      background: var(--color-bg);
      border-right: 1px solid var(--color-rule);
    }

    /* 把手：从侧栏右边缘伸出，竖排文字 */
    .handle {
      position: absolute;
      top: 8rem;
      left: 100%;
      /* 宽度只容一个字，"目录"两字自然竖排 */
      width: 1.9rem;
      padding: 0.75rem 0.4rem;
      line-height: 1.3;
      letter-spacing: 0.2em;
      border-left: none;
      border-radius: 0 var(--radius) var(--radius) 0;
    }
  }

  /* 常驻：正文左侧的一列（宽度由 EntryLayout 的网格决定），滚动时贴在窗口顶部；
     68rem 与 global.css 的宽版面断点一致 */
  @media (min-width: 68rem) {
    .toc.pinned {
      position: sticky;
      top: 2rem;
      bottom: auto;
      width: auto;
      transform: none;
      transition: none;
    }

    .pinned .panel {
      height: auto;
      max-height: calc(100vh - 4rem);
      padding: 0 1.5rem 0 0;
      background: none;
      border-right: 1px solid var(--color-rule);
    }

    .pinned .handle {
      display: none;
    }
  }

  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .toc {
      transition: none;
    }
  }

  /* 手机：页面顶部的折叠目录 */
  @media (max-width: 47.99rem) {
    .toc {
      margin-bottom: 2rem;
    }

    .handle {
      width: 100%;
      padding: 0.5rem 0.75rem;
      text-align: left;
      border-radius: var(--radius);
    }

    .handle::after {
      content: ' ▾';
    }

    .toc[data-open] .handle::after {
      content: ' ▴';
    }

    .toc:not([data-open]) .panel {
      display: none;
    }

    .panel {
      padding: 1rem 0.75rem 0;
    }
  }
</style>
