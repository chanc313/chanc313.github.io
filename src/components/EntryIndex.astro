---
// 按年份分组的目录：年份在左侧栏，标题和日期在右侧。
// 首页、各栏目首页、标签页、技术理论的话题页共用。
// 传 entries（内容条目）或 items（已整理好的条目，如话题页里"一个系列算一项"）二选一。
// showColumn 为 true 时，在标题后标出所属栏目（混合多个栏目时使用）。
import { groupByYear, formatDate, entryUrl, columnOf, type Entry, type IndexItem } from '../utils';

interface Props {
  entries?: Entry[];
  items?: IndexItem[];
  showColumn?: boolean;
}

const { entries = [], items, showColumn = false } = Astro.props;
const list: IndexItem[] =
  items ??
  entries.map((entry) => ({
    title: entry.data.title,
    url: entryUrl(entry),
    date: entry.data.date,
    label: showColumn ? columnOf(entry).label : undefined,
    draft: entry.data.draft,
  }));
const groups = groupByYear(list);
---

<div class="index">
  {
    groups.map(([year, yearItems]) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`} class="year-label">{year}</h2>
        <ol class="entries">
          {yearItems.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
              {item.label && <span class="column">{item.label}</span>}
              {item.draft && <span class="draft">草稿</span>}
              <time datetime={item.date.toISOString()}>{formatDate(item.date, 'short')}</time>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    align-items: baseline;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .year-label {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.35rem;
  }

  li a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-lg);
  }

  li a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .column,
  .draft {
    flex-shrink: 0;
    font-size: var(--text-sm);
  }

  .column {
    color: var(--color-muted);
  }

  .draft {
    color: var(--color-accent);
  }

  time {
    margin-left: auto;
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 手机上年份放到上方 */
  @media (max-width: 36rem) {
    .year {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
