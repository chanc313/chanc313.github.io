---
// 按年份分组的目录：年份在左侧栏，标题和日期在右侧。
// 首页、各栏目首页、标签页共用。
// showColumn 为 true 时，在标题后标出所属栏目（混合多个栏目时使用）。
import { groupByYear, formatDate, entryUrl, columnOf, type Entry } from '../utils';

interface Props {
  entries: Entry[];
  showColumn?: boolean;
}

const { entries, showColumn = false } = Astro.props;
const groups = groupByYear(entries);
---

<div class="index">
  {
    groups.map(([year, items]) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`} class="year-label">{year}</h2>
        <ol class="entries">
          {items.map((entry) => (
            <li>
              <a href={entryUrl(entry)}>{entry.data.title}</a>
              {showColumn && <span class="column">{columnOf(entry).label}</span>}
              {entry.data.draft && <span class="draft">草稿</span>}
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date, 'short')}
              </time>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    align-items: baseline;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .year-label {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.35rem;
  }

  li a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-lg);
  }

  li a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .column,
  .draft {
    flex-shrink: 0;
    font-size: var(--text-sm);
  }

  .column {
    color: var(--color-muted);
  }

  .draft {
    color: var(--color-accent);
  }

  time {
    margin-left: auto;
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 手机上年份放到上方 */
  @media (max-width: 36rem) {
    .year {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
