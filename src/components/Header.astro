---
// 页头：网站名 + 导航 + 深浅色切换按钮
import { SITE_TITLE } from '../consts';
import { COLUMNS } from '../columns';
import ThemeToggle from './ThemeToggle.astro';

// 导航链接：先是各栏目（来自 src/columns.ts），再是其他独立页面。
// 想加独立页面，在 pages 数组里加一行。
const pages = [
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
const columns = COLUMNS.map((c) => ({ href: c.path, label: c.label }));

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="container site-header">
  <a class="site-name" href="/">{SITE_TITLE}</a>
  <nav aria-label="主导航">
    <!-- 栏目 -->
    <ul class="columns">
      {
        columns.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- 独立页面 -->
    <ul>
      {
        pages.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
  }

  .site-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 栏目组与独立页面组之间的分隔线，表示两类链接性质不同 */
  .columns {
    padding-right: 1.25rem;
    border-right: 1px solid var(--color-rule);
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.35em;
  }
</style>
