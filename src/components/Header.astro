---
// 页头：网站名 + 导航 + 深浅色切换按钮
import { SITE_TITLE } from '../consts';
import { COLUMNS } from '../columns';
import ThemeToggle from './ThemeToggle.astro';
import AdminLink from './AdminLink.astro';

// 导航链接：各栏目（来自 src/columns.ts）和其他独立页面，分两处显示。
// 想加独立页面，在 pages 数组里加一行。
const pages = [
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
interface Props {
  /** 替换某个栏目在导航中的文字和链接，如进入目录后显示目录名（见 NodeLayout） */
  columnOverride?: { id: string; label: string; href: string };
}

const { columnOverride } = Astro.props;
const columns = COLUMNS.map((c) =>
  c.id === columnOverride?.id
    ? { href: columnOverride.href, label: columnOverride.label, current: true }
    : { href: c.path, label: c.label, current: false },
);

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<!--
  页头分两行：
    第一行：网站名（左）；独立页面、后台入口、深浅色切换（右）
    第二行：全部栏目。栏目多了会自动换行，手机上也不会撑出横向滚动。
-->
<header class="container site-header">
  <div class="top">
    <a class="site-name" href="/">{SITE_TITLE}</a>
    <div class="tools">
      <nav aria-label="页面">
        <ul>
          {
            pages.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <AdminLink />
      <ThemeToggle />
    </div>
  </div>
  <nav aria-label="栏目">
    <ul class="columns">
      {
        columns.map(({ href, label, current }) => (
          <li>
            <a href={href} aria-current={current || isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding-top: 2rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .site-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 栏目一行：与网站名之间留出距离，下方一条细线把页头和正文隔开 */
  .columns {
    margin-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-rule);
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  /* 独立页面是次要入口，字号小一号 */
  .tools nav a {
    font-size: var(--text-sm);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.35em;
  }
</style>
