---
// 首页：一句大字介绍 + 按年份排列的全部文章
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndex from '../components/PostIndex.astro';
import { HOME_INTRO } from '../consts';
import { getPosts } from '../utils';

const posts = await getPosts();
---

<BaseLayout>
  <h1 class="intro">{HOME_INTRO}</h1>
  {
    posts.length > 0 ? (
      <PostIndex posts={posts} />
    ) : (
      <p class="empty">
        还没有文章。在 <code>src/content/blog/</code> 里新建一个 <code>.md</code> 文件，就是第一篇。
      </p>
    )
  }
</BaseLayout>

<style>
  .intro {
    font-size: var(--text-3xl);
    line-height: 1.45;
    margin: 1rem 0 3.5rem;
    white-space: pre-line; /* 让介绍文字里的 \n 变成换行 */
  }

  .empty {
    color: var(--color-muted);
  }

  @media (max-width: 36rem) {
    .intro {
      font-size: var(--text-xl);
      margin-bottom: 2.5rem;
    }
  }
</style>
