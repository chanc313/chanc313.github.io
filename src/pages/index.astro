---
// 首页：一句大字介绍 + 所有栏目的内容按年份汇总，每条标出所属栏目
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryIndex from '../components/EntryIndex.astro';
import { HOME_INTRO } from '../consts';
import { getAllEntries } from '../utils';

const entries = await getAllEntries();
---

<BaseLayout>
  <h1 class="intro">{HOME_INTRO}</h1>
  {
    entries.length > 0 ? (
      <EntryIndex entries={entries} showColumn />
    ) : (
      <p class="empty">还没有内容。</p>
    )
  }
</BaseLayout>

<style>
  .intro {
    font-size: var(--text-3xl);
    line-height: 1.45;
    margin: 1rem 0 3.5rem;
    white-space: pre-line; /* 让介绍文字里的 \n 变成换行 */
  }

  .empty {
    color: var(--color-muted);
  }

  @media (max-width: 36rem) {
    .intro {
      font-size: var(--text-xl);
      margin-bottom: 2.5rem;
    }
  }
</style>
