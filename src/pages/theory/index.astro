---
// "技术理论"栏目首页：/theory/。与其他栏目不同，这里是话题（一级目录）的扁平列表（类似标签页），
// 点进话题才看到文章目录；不在任何目录里的文章列在「未归入话题」
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryIndex from '../../components/EntryIndex.astro';
import WriteLink from '../../components/WriteLink.astro';
import { getColumn } from '../../columns';
import { articlesUnder, entryUrl, getTree, indexItems, isFolder } from '../../utils';

const column = getColumn('theory');
const { roots } = await getTree('theory');
const topics = roots.filter((n) => isFolder(n.entry));
const loose = roots.filter((n) => !isFolder(n.entry));
---

<BaseLayout title={column.label} description={column.description}>
  <h1 class="visually-hidden">{column.label}</h1>
  <WriteLink href="/write/?column=theory" />
  <ul class="topic-list">
    {
      topics.map((n) => (
        <li>
          <a href={entryUrl(n.entry)}>{n.entry.data.title}</a>
          <span>{articlesUnder(n).length}</span>
        </li>
      ))
    }
  </ul>
  {
    loose.length > 0 && (
      <section class="loose">
        <h2>未归入话题</h2>
        <EntryIndex items={indexItems(loose)} />
      </section>
    )
  }
</BaseLayout>

<style>
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-list a {
    font-size: var(--text-lg);
  }

  .topic-list span {
    margin-left: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .loose h2 {
    font-size: var(--text-xl);
    margin: 3rem 0 1rem;
  }
</style>
