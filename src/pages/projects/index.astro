---
// "项目"栏目首页：/projects/。一个项目（目录）算一项，项目里的各页在项目的目录侧栏里
import ColumnLayout from '../../layouts/ColumnLayout.astro';
import { getColumn } from '../../columns';
import { getTree, indexItems } from '../../utils';

const { roots } = await getTree('projects');
---

<ColumnLayout column={getColumn('projects')} items={indexItems(roots)} />
