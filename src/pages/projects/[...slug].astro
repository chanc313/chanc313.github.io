---
// "项目"栏目的内容页：src/content/projects/ 里每个资源包生成一个 /projects/<页面名>/ 页面
import { render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getEntries } from '../../utils';

type Post = CollectionEntry<'projects'>;

export async function getStaticPaths() {
  const entries = await getEntries('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Post;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout entry={entry}>
  <Content />
</EntryLayout>
