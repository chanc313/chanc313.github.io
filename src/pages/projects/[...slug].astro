---
// "项目"栏目的内容页：src/content/projects/ 里的每个页面生成 /projects/<路径>/。
// 一个项目是一个一级目录，正文是项目介绍；开发日志等放在它下面，可以再分子目录。
// 项目里的页面在宽屏时目录侧栏常驻左侧（src/columns.ts 的 pinnedNav）；页面怎么显示见 NodeLayout
import NodeLayout from '../../layouts/NodeLayout.astro';
import { treePaths, type TreeNode } from '../../utils';

export async function getStaticPaths() {
  return treePaths('projects');
}

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
---

<NodeLayout node={node} />
