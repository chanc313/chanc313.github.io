---
// 单个标签页：列出带这个标签的所有文章
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPosts, countTags, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return countTags(posts).map(([tag]) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <h1>#{tag}</h1>
  <p class="count">共 {posts.length} 篇。<a href="/tags/">查看全部标签</a></p>
  <PostIndex posts={posts} />
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-2xl);
    margin: 1rem 0 0.25rem;
  }

  .count {
    margin: 0 0 2rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
