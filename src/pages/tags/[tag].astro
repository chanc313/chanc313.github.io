---
// 单个标签页：列出所有栏目中带这个标签的内容，并标出所属栏目
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryIndex from '../../components/EntryIndex.astro';
import { getAllEntries, countTags, type Entry } from '../../utils';

export async function getStaticPaths() {
  const entries = await getAllEntries();
  return countTags(entries).map(([tag]) => ({
    params: { tag },
    props: { entries: entries.filter((e) => e.data.tags.includes(tag)) },
  }));
}

interface Props {
  entries: Entry[];
}

const { tag } = Astro.params;
const { entries } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <h1>#{tag}</h1>
  <p class="count">共 {entries.length} 条。<a href="/tags/">查看全部标签</a></p>
  <EntryIndex entries={entries} showColumn />
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-2xl);
    margin: 1rem 0 0.25rem;
  }

  .count {
    margin: 0 0 2rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
