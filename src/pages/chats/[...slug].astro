---
// "AI对话"栏目的内容页：src/content/chats/ 里每个资源包生成一个 /chats/<页面名>/ 页面
// 与文章页的区别：日期后显示对话对象；正文前显示批注；正文按发言人分段（见 src/plugins/remark-chat-turns.mjs）
import { render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getEntries } from '../../utils';

type Chat = CollectionEntry<'chats'>;

export async function getStaticPaths() {
  const entries = await getEntries('chats');
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

interface Props {
  entry: Chat;
  newer?: Chat;
  older?: Chat;
}

const { entry, newer, older } = Astro.props;
const { ai, note } = entry.data;
const { Content } = await render(entry);
---

<EntryLayout entry={entry} newer={newer} older={older} bodyClass="chat">
  <span slot="meta">对话对象：{ai}</span>
  {note && <p slot="intro" class="note">{note}</p>}
  <Content />
</EntryLayout>

<style>
  /* 批注：标题区下方，说明这段对话为什么值得留下 */
  .note {
    margin: -1rem 0 2.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
  }
</style>
