---
// "文章"栏目的内容页：src/content/posts/ 里每个资源包生成一个 /posts/<页面名>/ 页面
// 对话记录也放在这里：填了 ai 字段时日期后显示对话对象，填了 note 时正文前显示批注；
// 正文按发言人分段由 src/plugins/remark-chat-turns.mjs 处理
import { render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getEntries } from '../../utils';

type Post = CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const entries = await getEntries('posts');
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    // entries 从新到旧排列：newer 是更新的一篇，older 是更早的一篇
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

interface Props {
  entry: Post;
  newer?: Post;
  older?: Post;
}

const { entry, newer, older } = Astro.props;
const { ai, note } = entry.data;
const { Content } = await render(entry);
---

<EntryLayout entry={entry} newer={newer} older={older}>
  {ai && <span slot="meta">对话对象：{ai}</span>}
  {note && <p slot="intro" class="note">{note}</p>}
  <Content />
</EntryLayout>

<style>
  /* 批注：标题区下方、正文之前 */
  .note {
    margin: -1rem 0 2.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
  }
</style>
