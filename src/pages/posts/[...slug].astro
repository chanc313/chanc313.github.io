---
// "文章"栏目的内容页：src/content/posts/ 里的每个页面生成 /posts/<路径>/，页面怎么显示见 NodeLayout。
// 对话记录也放在这里：填了 ai 字段时日期后显示对话对象，填了 note 时正文前显示批注；
// 正文按发言人分段由 src/plugins/remark-chat-turns.mjs 处理
import type { CollectionEntry } from 'astro:content';
import NodeLayout from '../../layouts/NodeLayout.astro';
import { treePaths, type TreeNode } from '../../utils';

export async function getStaticPaths() {
  return treePaths('posts');
}

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
const { ai, note } = node.entry.data as CollectionEntry<'posts'>['data'];
---

<NodeLayout node={node}>
  {ai && <span slot="meta">对话对象：{ai}</span>}
  {note && <p slot="intro" class="note">{note}</p>}
</NodeLayout>

<style>
  /* 批注：标题区下方、正文之前 */
  .note {
    margin: -1rem 0 2.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
  }
</style>
