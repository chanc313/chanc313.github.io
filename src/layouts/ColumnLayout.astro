---
// 栏目首页的布局：栏目名 + 按年份排列的目录。各栏目的 index.astro 共用。
import BaseLayout from './BaseLayout.astro';
import EntryIndex from '../components/EntryIndex.astro';
import WriteLink from '../components/WriteLink.astro';
import type { Column } from '../columns';
import type { Entry, IndexItem } from '../utils';

interface Props {
  column: Column;
  /** 传 entries（内容条目）或 items（已整理好的条目，如目录带"共 3 篇"标注）二选一 */
  entries?: Entry[];
  items?: IndexItem[];
}

const { column, entries = [], items } = Astro.props;
---

<BaseLayout title={column.label} description={column.description}>
  <h1 class="visually-hidden">{column.label}</h1>
  <WriteLink href={`/write/?column=${column.id}`} />
  {
    (items ?? entries).length > 0 ? (
      <EntryIndex entries={entries} items={items} />
    ) : (
      <p class="empty">这个栏目还没有内容。</p>
    )
  }
</BaseLayout>

<style>
  .empty {
    color: var(--color-muted);
  }
</style>
