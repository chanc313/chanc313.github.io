---
// 单条内容页面的布局：标题、日期、标签、正文、上一篇/下一篇。
// 所有栏目的内容页共用；栏目各自的差异通过两个插槽补充：
//   slot="meta"   日期后面追加的信息（如对话对象）
//   slot="intro"  标题区与正文之间的内容（如对话批注）
//   slot="aside"  文章之前的内容（如技术理论的目录侧栏）
import BaseLayout from './BaseLayout.astro';
import { formatDate, entryUrl, type Entry } from '../utils';

interface Props {
  entry: Entry;
  newer?: Entry;
  older?: Entry;
  /** 加在正文容器上的额外 class，供栏目定制正文样式 */
  bodyClass?: string;
  /** 翻页链接的说明文字，默认按日期（更早 / 更新）；按目录顺序翻页时传 ['上一篇', '下一篇'] */
  pagerLabels?: [string, string];
  /** 见 Header 的 columnOverride */
  columnOverride?: { id: string; label: string; href: string };
}

const { entry, newer, older, bodyClass, pagerLabels = ['更早', '更新'], columnOverride } = Astro.props;
const { title, description, date, updated, tags } = entry.data;
---

<BaseLayout title={title} description={description} columnOverride={columnOverride}>
  <slot name="aside" />
  <article>
    <header class="entry-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>更新于 {formatDate(updated)}</span>}
        <slot name="meta" />
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="标签">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <slot name="intro" />

    <div class:list={['prose', bodyClass]}>
      <slot />
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="pager" aria-label="上一篇和下一篇">
        {older ? (
          <a href={entryUrl(older)} class="older">
            <span>{pagerLabels[0]}</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a href={entryUrl(newer)} class="newer">
            <span>{pagerLabels[1]}</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<style>
  .entry-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: var(--text-3xl);
    margin: 1rem 0 0.75rem;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .tags a {
    text-decoration: none;
  }

  .tags a:hover {
    text-decoration: underline;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .pager a:hover {
    color: var(--color-accent);
  }

  .pager span {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }

  .newer {
    text-align: right;
  }

  @media (max-width: 36rem) {
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
