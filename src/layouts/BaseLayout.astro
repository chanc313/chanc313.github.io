---
// 所有页面共用的外壳：<head> 信息、页头、页脚。每个页面都套在它里面。
// 标题字体：霞鹜文楷。随网站一起发布，按需分片加载（只下载页面里用到的字）
import 'lxgw-wenkai-screen-webfont/lxgwwenkaiscreen.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 见 Header 的 columnOverride */
  columnOverride?: { id: string; label: string; href: string };
  /** 不让搜索引擎收录（如写作页） */
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, columnOverride, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- 在页面显示前读取用户上次选的深色/浅色，避免闪烁 -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header columnOverride={columnOverride} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    padding-block: 3rem 5rem;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-text);
    color: var(--color-bg);
    z-index: 10;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
